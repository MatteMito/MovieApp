    <!-- HELP DIALOGS -->
    <string name="imdb_help_title">So exportieren Sie von IMDb</string>
    <string name="letterboxd_help_title">So exportieren Sie von Letterboxd</string>

    <string name="imdb_watched_help">1. Gehen Sie zu IMDb.com\n2. Melden Sie sich bei Ihrem Konto an\n3. Gehen Sie zu \"Your Ratings\"\n4. Klicken Sie auf die drei Punkte und \"Export\"\n5. Laden Sie die CSV-Datei herunter\n\nWählen Sie die heruntergeladene Datei zum Importieren aus.</string>
    <string name="imdb_watchlist_help">1. Gehen Sie zu IMDb.com\n2. Melden Sie sich bei Ihrem Konto an\n3. Gehen Sie zu \"Your Watchlist\"\n4. Klicken Sie auf die drei Punkte und \"Export\"\n5. Laden Sie die CSV-Datei herunter\n\nWählen Sie die heruntergeladene Datei zum Importieren aus.</string>
    <string name="letterboxd_watched_help">1. Gehen Sie zu Letterboxd.com\n2. Melden Sie sich bei Ihrem Konto an\n3. Gehen Sie zu Settings > Import &amp; Export\n4. Klicken Sie auf \"Export Your Data\"\n5. Laden Sie \"watched.csv\" herunter\n\nWählen Sie die heruntergeladene Datei zum Importieren aus.</string>
    <string name="letterboxd_watchlist_help">1. Gehen Sie zu Letterboxd.com\n2. Melden Sie sich bei Ihrem Konto an\n3. Gehen Sie zu Settings > Import &amp; Export\n4. Klicken Sie auf \"Export Your Data\"\n5. Laden Sie \"watchlist.csv\" herunter\n\nWählen Sie die heruntergeladene Datei zum Importieren aus.</string>

