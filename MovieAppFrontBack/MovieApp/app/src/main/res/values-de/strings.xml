    <!-- help dialogs -->
    <string name="imdb_help_title">So exportierst du von IMDb</string>
    <string name="letterboxd_help_title">So exportierst du von Letterboxd</string>

    <string name="imdb_watched_help">1. Gehe zu IMDb.com\n2. Melde dich an\n3. Gehe zu \"Your Ratings\"\n4. Klicke auf die drei Punkte und \"Export\"\n5. Lade die CSV-Datei herunter\n\nWähle die heruntergeladene Datei zum Importieren aus.</string>
    <string name="imdb_watchlist_help">1. Gehe zu IMDb.com\n2. Melde dich an\n3. Gehe zu \"Your Watchlist\"\n4. Klicke auf die drei Punkte und \"Export\"\n5. Lade die CSV-Datei herunter\n\nWähle die heruntergeladene Datei zum Importieren aus.</string>
    <string name="letterboxd_watched_help">1. Gehe zu Letterboxd.com\n2. Melde dich an\n3. Gehe zu Settings > Import &amp; Export\n4. Klicke auf \"Export Your Data\"\n5. Lade \"watched.csv\" herunter\n\nWähle die heruntergeladene Datei zum Importieren aus.</string>
    <string name="letterboxd_watchlist_help">1. Gehe zu Letterboxd.com\n2. Melde dich an\n3. Gehe zu Settings > Import &amp; Export\n4. Klicke auf \"Export Your Data\"\n5. Lade \"watchlist.csv\" herunter\n\nWähle die heruntergeladene Datei zum Importieren aus.</string>

    <string name="import_info_text">Wähle CSV-Dateien von IMDb oder Letterboxd aus, um deine Filme zu importieren.\n\nDie App wird sie automatisch mit TMDB-Daten anreichern (Poster, Details, Bewertungen).\n\nÜberprüfe nach dem Import deine Statistiken im Dashboard!</string>

