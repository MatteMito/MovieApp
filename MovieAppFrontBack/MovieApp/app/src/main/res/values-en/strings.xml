    <string name="imdb_help_title">How to export from IMDb</string>
    <string name="letterboxd_help_title">How to export from Letterboxd</string>

    <string name="imdb_watched_help">1. Go to IMDb.com\n2. Sign in to your account\n3. Go to \"Your Ratings\"\n4. Click the three dots and \"Export\"\n5. Download the CSV file\n\nSelect the downloaded file to import it.</string>
    <string name="imdb_watchlist_help">1. Go to IMDb.com\n2. Sign in to your account\n3. Go to \"Your Watchlist\"\n4. Click the three dots and \"Export\"\n5. Download the CSV file\n\nSelect the downloaded file to import it.</string>
    <string name="letterboxd_watched_help">1. Go to Letterboxd.com\n2. Sign in to your account\n3. Go to Settings > Import &amp; Export\n4. Click \"Export Your Data\"\n5. Download \"watched.csv\"\n\nSelect the downloaded file to import it.</string>
    <string name="letterboxd_watchlist_help">1. Go to Letterboxd.com\n2. Sign in to your account\n3. Go to Settings > Import &amp; Export\n4. Click \"Export Your Data\"\n5. Download \"watchlist.csv\"\n\nSelect the downloaded file to import it.</string>

    <string name="import_info_text">Select CSV files from IMDb or Letterboxd to import your movies.\n\nThe app will automatically enrich them with TMDB data (posters, details, ratings).\n\nAfter importing, check out your statistics in the Dashboard!</string>

