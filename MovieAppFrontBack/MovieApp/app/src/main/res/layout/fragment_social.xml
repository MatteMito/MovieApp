<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/res/layout/fragment_social.xml -->
<!-- Layout per SocialFragment con tab e liste -->

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- SwipeRefreshLayout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="?attr/colorPrimary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Le Mie Liste"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crea e condividi le tue collezioni di film"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:alpha="0.9"/>
                </LinearLayout>

                <!-- Tab Layout -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabTextColor="?android:attr/textColorSecondary"
                    app:tabSelectedTextColor="?attr/colorPrimary"
                    app:tabIndicatorColor="?attr/colorPrimary">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Le Mie Liste" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liste Pubbliche" />
                </com.google.android.material.tabs.TabLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <!-- Le Mie Liste RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_my_lists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="80dp"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_social_list"
                    tools:itemCount="3"/>

                <!-- Empty State - Le Mie Liste -->
                <LinearLayout
                    android:id="@+id/empty_state_my_lists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="48dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="72sp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nessuna lista creata"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tocca il pulsante + per creare\nla tua prima lista di film!"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_create_first"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crea Lista"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_input_add"
                        style="@style/Widget.Material3.Button"/>
                </LinearLayout>

                <!-- Liste Pubbliche RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_public_lists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="80dp"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_social_list"
                    tools:itemCount="3"/>

                <!-- Empty State - Liste Pubbliche -->
                <LinearLayout
                    android:id="@+id/empty_state_public_lists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="48dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌍"
                        android:textSize="72sp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nessuna lista pubblica"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sii il primo a condividere\nuna lista pubblica!"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Not Authenticated State -->
                <TextView
                    android:id="@+id/text_not_authenticated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="48dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:visibility="gone"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB per creare lista -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_create_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Crea nuova lista"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>