<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Poster piccolo -->
        <ImageView
            android:id="@+id/image_poster"
            android:layout_width="60dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:background="@color/text_hint"
            android:contentDescription="Poster"
            android:layout_marginEnd="12dp" />

        <!-- Info film -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Titolo -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Titolo Film"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Anno e Regista -->
            <TextView
                android:id="@+id/text_year_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2020 • Christopher Nolan"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Generi -->
            <TextView
                android:id="@+id/text_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Action, Drama, Sci-Fi"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Rating e stato -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/warning_orange"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <!-- Badge Visto -->
                <TextView
                    android:id="@+id/badge_watched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Visto"
                    android:textSize="10sp"
                    android:textColor="@android:color/white"
                    android:background="@color/success_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>