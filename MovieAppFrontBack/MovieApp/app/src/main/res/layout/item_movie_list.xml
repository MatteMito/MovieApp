<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header lista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/text_list_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="I miei film preferiti" />

            <TextView
                android:id="@+id/badge_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pubblica"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/badge_public_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Descrizione -->
        <TextView
            android:id="@+id/text_list_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Lista dei miei film d'azione preferiti di tutti i tempi"
            tools:visibility="visible" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/text_movie_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:drawableStart="@drawable/ic_home"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorPrimary"
                android:layout_marginEnd="16dp"
                tools:text="15 film" />

            <TextView
                android:id="@+id/text_deadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="?attr/colorError"
                android:drawableStart="@drawable/ic_notifications"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorError"
                android:visibility="gone"
                tools:text="Scadenza: 31/12/2024"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_followers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:drawableStart="@drawable/ic_dashboard"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="42 follower"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Azioni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <Button
                android:id="@+id/button_edit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifica"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/button_delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elimina"
                android:textSize="14sp"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/button_follow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Segui"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>