<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Card Progress Import -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_import_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Titolo Progress -->
                    <TextView
                        android:id="@+id/text_import_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        tools:text="✨ Enrichment TMDB..."/>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progress_bar_import"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="45"
                        android:indeterminate="false"
                        android:layout_marginBottom="8dp"/>

                    <!-- Testo Progress -->
                    <TextView
                        android:id="@+id/text_progress_import"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="23 / 50 (46%)"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Statistiche Permanente - SOLO 3 STATS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stats_permanent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/layout_import_progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Le Tue Statistiche"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Grid Statistiche - SOLO 3 CELLE -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="1">

                        <!-- Totali -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/text_total_movies"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                tools:text="164"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Totali"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"/>
                        </LinearLayout>

                        <!-- Visti -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/text_watched_movies"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_green_dark"
                                tools:text="100"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Visti"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"/>
                        </LinearLayout>

                        <!-- Da vedere -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/text_watchlist_movies"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_orange_dark"
                                tools:text="64"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Da Vedere"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"/>
                        </LinearLayout>

                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sezione IMDB -->
            <TextView
                android:id="@+id/text_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 IMDB"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/card_stats_permanent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Bottone Importa IMDB Watched -->
            <Button
                android:id="@+id/button_import_imdb_watched"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📥 Importa Watched"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_header"/>

            <!-- Bottone Importa IMDB Watchlist -->
            <Button
                android:id="@+id/button_import_imdb_watchlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📥 Importa Watchlist"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_import_imdb_watched"/>

            <!-- Sezione Letterboxd -->
            <TextView
                android:id="@+id/text_letterboxd_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Letterboxd"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/button_import_imdb_watchlist"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Bottone Importa Letterboxd Watched -->
            <Button
                android:id="@+id/button_import_letterboxd_watched"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📥 Importa Watched"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_letterboxd_header"/>

            <!-- Bottone Importa Letterboxd Watchlist -->
            <Button
                android:id="@+id/button_import_letterboxd_watchlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📥 Importa Watchlist"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_import_letterboxd_watched"/>

            <!-- Sezione Azioni -->
            <TextView
                android:id="@+id/text_actions_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Azioni"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/button_import_letterboxd_watchlist"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Bottone Clear All -->
            <Button
                android:id="@+id/button_clear_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🗑️ Elimina Tutti i Film"
                android:textAllCaps="false"
                android:backgroundTint="@android:color/holo_red_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_actions_header"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>