    <!-- HELP DIALOGS -->
    <string name="imdb_help_title">Cómo exportar desde IMDb</string>
    <string name="letterboxd_help_title">Cómo exportar desde Letterboxd</string>

    <string name="imdb_watched_help">1. Ve a IMDb.com\n2. Inicia sesión en tu cuenta\n3. Ve a \"Your Ratings\"\n4. Haz clic en los tres puntos y \"Export\"\n5. Descarga el archivo CSV\n\nSelecciona el archivo descargado para importarlo.</string>
    <string name="imdb_watchlist_help">1. Ve a IMDb.com\n2. Inicia sesión en tu cuenta\n3. Ve a \"Your Watchlist\"\n4. Haz clic en los tres puntos y \"Export\"\n5. Descarga el archivo CSV\n\nSelecciona el archivo descargado para importarlo.</string>
    <string name="letterboxd_watched_help">1. Ve a Letterboxd.com\n2. Inicia sesión en tu cuenta\n3. Ve a Settings > Import &amp; Export\n4. Haz clic en \"Export Your Data\"\n5. Descarga \"watched.csv\"\n\nSelecciona el archivo descargado para importarlo.</string>
    <string name="letterboxd_watchlist_help">1. Ve a Letterboxd.com\n2. Inicia sesión en tu cuenta\n3. Ve a Settings > Import &amp; Export\n4. Haz clic en \"Export Your Data\"\n5. Descarga \"watchlist.csv\"\n\nSelecciona el archivo descargado para importarlo.</string>

    <string name="import_info_text">Selecciona archivos CSV de IMDb o Letterboxd para importar tus películas.\n\nLa app las enriquecerá automáticamente con datos de TMDB (posters, detalles, valoraciones).\n\n📊 Después de importar, revisa tus estadísticas en el Dashboard!</string>

