    <!-- help dialogs -->
    <string name="imdb_help_title">Comment exporter depuis IMDb</string>
    <string name="letterboxd_help_title">Comment exporter depuis Letterboxd</string>

    <string name="imdb_watched_help">1. Allez sur IMDb.com\n2. Connectez-vous à votre compte\n3. Allez dans \"Your Ratings\"\n4. Cliquez sur les trois points et \"Export\"\n5. Téléchargez le fichier CSV\n\nSélectionnez le fichier téléchargé pour l\'importer.</string>
    <string name="imdb_watchlist_help">1. Allez sur IMDb.com\n2. Connectez-vous à votre compte\n3. Allez dans \"Your Watchlist\"\n4. Cliquez sur les trois points et \"Export\"\n5. Téléchargez le fichier CSV\n\nSélectionnez le fichier téléchargé pour l\'importer.</string>
    <string name="letterboxd_watched_help">1. Allez sur Letterboxd.com\n2. Connectez-vous à votre compte\n3. Allez dans Settings > Import &amp; Export\n4. Cliquez sur \"Export Your Data\"\n5. Téléchargez \"watched.csv\"\n\nSélectionnez le fichier téléchargé pour l\'importer.</string>
    <string name="letterboxd_watchlist_help">1. Allez sur Letterboxd.com\n2. Connectez-vous à votre compte\n3. Allez dans Settings > Import &amp; Export\n4. Cliquez sur \"Export Your Data\"\n5. Téléchargez \"watchlist.csv\"\n\nSélectionnez le fichier téléchargé pour l\'importer.</string>

    <string name="import_info_text">Sélectionnez des fichiers CSV d\'IMDb ou Letterboxd pour importer vos films.\n\nL\'application les enrichira automatiquement avec les données TMDB (affiches, détails, notes).\n\nAprès l\'importation, consultez vos statistiques dans le Dashboard!</string>

