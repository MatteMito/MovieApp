# Copy this file to .env and fill in the empty values.

# Server
HOST=0.0.0.0
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=movieapp

# JWT authentication (use a long random string, e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_EXPIRATION=7d

# TMDB API (free key: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Weekly/monthly sync of popular films from TMDB
ENABLE_AUTO_SYNC=false
