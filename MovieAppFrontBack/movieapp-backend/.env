# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=movieapp

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# TMDB API (The Movie Database)
TMDB_API_KEY=9b81fdfa5c41e939da832b392a12cbc4
TMDB_BASE_URL=https://api.themoviedb.org/3

# Logging (silent per startup pulito)
LOG_LEVEL=warn

# CORS (per Android client)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=10000
RATE_LIMIT_MAX_REQUESTS=35